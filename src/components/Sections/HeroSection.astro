---
import Button from "../UI/Button.astro";
import OptimizedImage from "../UI/OptimizedImage.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Isaac Ramos",
  subtitle = "Artista visual y fotógrafo mexicano. Exploraciones sobre el desapego y resignificación del objeto personal.",
  backgroundImage = "/uploads/hero-bg.webp",
  } = Astro.props;
---

<section
  class="relative isolate min-h-screen flex items-center overflow-hidden m-8 md:m-0"
>
  <OptimizedImage
    src={backgroundImage}
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    ariaHidden={true}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(rgba(0,0,0,0.58), rgba(0,0,0,0.38));"
    aria-hidden="true"
  ></div>

  <div class="container relative z-10">
    <div class="max-w-3xl text-white">

        <h1 class="text-5xl text-gray-50 md:text-7xl font-bold font-serif mb-6 leading-tight">
          {title}
      </h1>

      <p class="text-xl md:text-2xl text-white/90 leading-relaxed max-w-2xl mb-12">
        {subtitle}
      </p>

      <div class="flex items-center gap-10">

        <!-- CTA principal -->
        <a
          href="/obras"
          class="group inline-flex items-center gap-2 uppercase tracking-[0.15em] text-sm"
        >
          <span>Ver obra</span>

          <span class="transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>

          <span
            class="absolute mt-8 h-px w-0 bg-white transition-all duration-300 group-hover:w-24">
          </span>

        </a>

        <!-- CTA secundario -->

        <a
          href="/sobre-mi"
          class="group inline-flex items-center gap-2 uppercase tracking-[0.15em] text-sm"
        >
          <span>Sobre mí</span>

          <span class="transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>

        </a>

      </div>

    </div>
  </div>

</section>