---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Isaac Ramos",
  subtitle = "Artista visual y fotógrafo mexicano. Exploraciones sobre el desapego y resignificación del objeto personal.",
  backgroundImage = "/uploads/hero-bg.jpg",
  } = Astro.props;
---

<section
  class="relative min-h-screen flex items-center bg-cover m-8 md:m-0"
  style={`background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.35)), url(${backgroundImage}); background-position: center 20%;`}
>

  <div class="container">
    <div class="min-h-[75px] text-white">
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">{title}</h1>
      <p class="text-xl md:text-2xl mb-8">{subtitle}</p>
    <div class="flex gap-4">
       <Button href="/obras">
        Ver obra
       </Button>

      <Button href="/sobre-mi" variant="outline">
         Sobre mí
       </Button>
      </div>
    </div>
  </div>
</section>