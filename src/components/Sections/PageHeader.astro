---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-white py-16 md:py-24">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-serif text-4xl font-medium leading-tight text-gray-900 md:text-5xl">
        {title}
      </h1>
      {subtitle && <p class="mt-5 text-lg text-gray-600 md:text-xl">{subtitle}</p>}
    </div>
  </div>
</section>