---
import { getCollection } from "astro:content";

interface BreadcrumbItem {
  name: string;
  href: string;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const segments = currentPath.split("/").filter(Boolean);

const staticLabels: Record<string, string> = {
  "/": "Inicio",
  "/obras": "Obras",
  "/obras/fotografia-contemporanea": "Fotografía contemporánea",
  "/obras/piezas-y-objetos": "Piezas y objetos",
  "/blog": "Blog",
  "/proyectos": "Proyectos",
  "/servicios": "Servicios",
  "/servicios/fotografia-producto": "Fotografía de Producto",
  "/servicios/retoque-fotografico": "Retoque Fotográfico",
  "/publicaciones": "Publicaciones",
  "/obra-disponible": "Obra disponible",
  "/contacto": "Contacto",
  "/sobre-mi": "Sobre mí",
  "/404": "Página no encontrada",
};

const currentSegment = segments[0];
const collectionsBySection = {
  obras: "obras",
  "obra-disponible": "obras",
  blog: "blog",
  proyectos: "proyectos",
  publicaciones: "publicaciones",
} as const;

let collectionLabel: string | undefined;
const collectionName = currentSegment && collectionsBySection[currentSegment as keyof typeof collectionsBySection];

if (segments.length > 1 && collectionName) {
  const entries = await getCollection(collectionName);
  const entry = entries.find((item) => item.slug === segments[1]);

  if (entry) {
    collectionLabel = "title" in entry.data
      ? entry.data.title
      : "name" in entry.data
        ? entry.data.name
        : undefined;
  }
}

const humanize = (value: string) =>
  decodeURIComponent(value)
    .replace(/[-_]+/g, " ")
    .replace(/\b\p{L}/gu, (character) => character.toLocaleUpperCase("es-MX"));

const breadcrumbItems: BreadcrumbItem[] = [{ name: "Inicio", href: "/" }];

for (let index = 0; index < segments.length; index += 1) {
  const href = `/${segments.slice(0, index + 1).join("/")}/`;
  const path = href.replace(/\/$/, "");
  const name = index === segments.length - 1 && collectionLabel
    ? collectionLabel
    : staticLabels[path] ?? humanize(segments[index]);

  breadcrumbItems.push({ name, href });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.href, Astro.site).toString(),
  })),
};

const jsonLd = JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c");
---

{currentPath !== "/" && (
  <div class="container">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <ol>
        {breadcrumbItems.map((item, index) => (
          <li>
            {index < breadcrumbItems.length - 1 ? (
              <a href={item.href}>{item.name}</a>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  </div>
)}

{currentPath !== "/" && (
  <script type="application/ld+json" set:html={jsonLd} />
)}

<style>
  .breadcrumbs {
    padding-block: 14px 10px;
    color: #6b6a64;
    font-size: 13px;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: "/";
    color: #aaa89f;
  }

  .breadcrumbs a:hover {
    color: #292825;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs [aria-current="page"] {
    color: #292825;
  }
</style>