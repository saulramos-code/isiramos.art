---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = [
  "inline-flex items-center justify-center gap-2",
  "font-sans text-base font-medium",
  "border rounded-md",
  "transition-all duration-500 ease-out",
  "focus:outline-none",
  "disabled:opacity-50 disabled:cursor-not-allowed",
];

const sizeStyles = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3",
  lg: "px-8 py-4 text-lg",
};

const variantStyles = {
  primary: [
    "bg-texto-950 text-white border-texto-950",
    "hover:bg-texto-800 hover:border-texto-800",
    "focus:ring-texto-700",
  ].join(" "),
  secondary: [
    "bg-gradient-to-r from-purple-600 to-purple-700 text-white border-purple-600",
    "hover:from-purple-700 hover:to-purple-800 hover:border-purple-700",
    "active:from-purple-800 active:to-purple-900",
    "focus:ring-purple-500",
  ].join(" "),
  accent: [
    "bg-naranja-100 text-white border-naranja-100",
    "hover:bg-naranjatinte-500",
    "hover:border-naranjatinte-500",
    "focus:ring-naranjatinte-400"
  ].join(" "),
  outline: [
    "bg-negro-200 text-texto-950 border-texto-300",
    "hover:border-texto-950",
    "hover:bg-texto-50",
    "focus:ring-texto-700"
  ].join(" "),
};

const classes = [
  ...baseStyles,
  sizeStyles[size],
  variantStyles[variant],
  className,
].join(" ");

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class={classes}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  disabled={disabled}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  role={!href ? "button" : undefined}
  {...rest}
>
  <slot />
</Element>

<style>
  /* Ensure proper touch target size on mobile */
  @media (max-width: 640px) {
    a, button {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>