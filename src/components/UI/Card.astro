---
import OptimizedImage from "./OptimizedImage.astro";

export interface Props {
  title: string;
  image?: {
    src: string;
    alt: string;
  };
  dataSeries?: string;
  dataAutor?: string;
  dataDate?: string;
  dataYear?: string | number;
  href?: string;
  className?: string;
  imageLayout?: 'top' | 'background';
}

const { title, image, href, className = "", imageLayout = 'top', dataSeries, dataAutor, dataDate, dataYear } = Astro.props;
const Element = href ? "a" : "div";
---

<Element
  href={href}
  aria-label={href ? title : undefined}
  data-series={dataSeries}
  data-speaker={dataAutor}
  data-date={dataDate}
  data-year={dataYear}
  class:list={[
    'card group overflow-hidden',
    { 'relative': imageLayout === 'background' },
    className
  ]}
>
  {image && (
    <div class:list={[
      'overflow-hidden',
      { 'absolute inset-0': imageLayout === 'background' }
    ]}>
      <OptimizedImage
        src={image.src}
        alt={image.alt}
        loading="lazy"
        decoding="async"
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class:list={[
          "w-full object-cover object-center transition-transform duration-300 hover:scale-105",
          { 'h-full': imageLayout === 'background', 'h-auto': imageLayout === 'top' }
        ]}
      />
    </div>
  )}

  <div class:list={[
    'p-5',
    { 'relative': imageLayout === 'background' }
  ]}>
    <h3 class="card-title mb-2">{title}</h3>
    <div class="text-gray-700">
      <slot />
    </div>
  </div>
</Element>
