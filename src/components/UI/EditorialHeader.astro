---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  maxWidth?: "sm" | "md" | "lg";
}

const {
  eyebrow,
  title,
  description,
  align = "center",
  maxWidth = "md",
} = Astro.props;

const widths = {
  sm: "max-w-2xl",
  md: "max-w-3xl",
  lg: "max-w-5xl",
};

const textAlign =
  align === "center"
    ? "mx-auto text-center"
    : "mr-auto text-left";
---

<div class:list={[widths[maxWidth], textAlign]}>

  {
    eyebrow && (
      <p class="uppercase tracking-[0.35em] text-xs text-gray-500 mb-5">
        {eyebrow}
      </p>
    )
  }

  <h1 class="text-4xl md:text-5xl font-bold leading-tight">
    {title}
  </h1>

  {
    description && (
      <p class="mt-8 text-lg leading-relaxed text-gray-600">
        {description}
      </p>
    )
  }

  <div
    class:list={[
      "mt-10 h-px w-20 bg-texto-900",
      align === "center" ? "mx-auto" : "",
    ]}
  ></div>

</div>