---
import { getImage } from "astro:assets";
import { resolveImage } from "../../utils/imageResolver";

export interface Props {
  title: string;
  description: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
  author?: string;

  robots?: string;

  artwork?: {
    name: string;
    year?: string | number;
  };
}

const {
  title,
  description,
  image = {
    url: "/uploads/social-share.webp",
    alt: "Isaac Ramos | Artista visual",
  },
  type = "website",
  canonicalUrl,
  author = "Isaac Ramos",
  robots = "index, follow",
  artwork,
} = Astro.props;

/*
 * Canonical URL
 * If a canonical URL is provided, use it.
 * Otherwise, generate it from the current pathname.
 */
const canonicalURL = canonicalUrl
  ? new URL(canonicalUrl, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

/*
 * Absolute image URL for Open Graph / Twitter.
 */
const socialImage = await getImage({
  src: resolveImage(image.url),
  width: 1200,
  format: "webp",
});
const imageURL = new URL(socialImage.src, Astro.site).toString();

const toJsonLd = (schema: Record<string, unknown>) =>
  JSON.stringify(schema).replace(/[<>&\u2028\u2029]/g, (character) =>
    `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`
  );
---

<meta name="publisher" content="Isaac Ramos" />

<!-- =====================================================
     BASIC SEO
====================================================== -->

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<meta
  name="robots"
  content={robots}
/>

<meta
  name="author"
  content={author}
/>

<link
  rel="canonical"
  href={canonicalURL}
/>


<!-- =====================================================
     OPEN GRAPH / FACEBOOK
====================================================== -->

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<meta
  property="og:image"
  content={imageURL}
/>

<meta
  property="og:image:alt"
  content={image.alt}
/>


<!-- =====================================================
     TWITTER / X
====================================================== -->

<meta
  name="twitter:card"
  content="summary_large_image"
/>

<meta
  name="twitter:url"
  content={canonicalURL}
/>

<meta
  name="twitter:title"
  content={title}
/>

<meta
  name="twitter:description"
  content={description}
/>

<meta
  name="twitter:image"
  content={imageURL}
/>

<meta
  name="twitter:image:alt"
  content={image.alt}
/>


<!-- =====================================================
     PERSON SCHEMA
====================================================== -->

<script
  type="application/ld+json"
  set:html={toJsonLd({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Isaac Ramos",
    "jobTitle": "Artista visual y fotógrafo",
    "email": "contacto@isiramos.art",
    "url": "https://isiramos.art"
  })}
/>

<!-- =====================================================
     VISUAL ARTWORK SCHEMA
====================================================== -->

{artwork && (
  <script
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "VisualArtwork",
      "name": artwork.name,
      "description": description,
      "image": imageURL,
      "url": canonicalURL.toString(),
      "creator": {
        "@type": "Person",
        "name": author,
        "url": "https://isiramos.art"
      },
      ...(artwork.year && {
        "dateCreated": String(artwork.year)
      }),
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL.toString()
      }
    })}
  />
)}


<!-- =====================================================
     ARTICLE SCHEMA
====================================================== -->

{
 type === "article" && !artwork && (
  <script
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": imageURL,
      "author": {
        "@type": "Person",
        "name": author,
        "url": "https://isiramos.art"
      },
      "url": canonicalURL.toString(),
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL.toString()
      }
    })}
  />
)}