---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import ObrasList from "../components/Sections/ObrasList.astro";
import PublicacionesList from "../components/Sections/PublicacionesList.astro";
import Button from "../components/UI/Button.astro";
---

<BaseLayout>
  <HeroSection 
    backgroundImage="/uploads/fondo-base.webp"
  />

  <!-- Obras Destacadas-->
  <ObrasList />

   <!-- About Isaac Ramos  -->
  <section class="py-[120px] bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img 
            src="/uploads/isaac-ramos.webp" 
            alt="isaac-ramos-artista-visual" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>
        
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Sobre Isaac Ramos</h2>
          <p class="text-gray-700 mb-6 text-lg">
            Fotógrafo y artista visual. Integrante del colectivo Tropical Fanzine, donde se producen publicaciones independientes. Su práctica gira en torno al desapego y la resignificación de experiencias personales mediante la reconfiguración de objetos cotidianos.
                    </p>
          <p class="text-gray-700 mb-8 text-lg">
            Ha exhibido su obra en el TYPA Letterpress and Paper Art Centre de Tartú, Estonia; Carnaval L'ours Noir Mont-Louis 2026, en colaboración con Aztrosharper; y en galerías como Galería Universitaria San Francisco de Borja, Galería Casa Habitación, Galería del Centro de Artes del NorteEs parte de la colección de la fanzinoteca del Museo Universitario del Chopo y la Libre.
          </p>
          
          <Button href="/sobre-mi">
            Ver CV
          </Button>
        </div>
      </div>
    </div>
  </section>



  <!-- Series fotográficas y proyectos artísticos  - Body Work - Cuerpo de Trabajo-->
  <section class="py-[120px] bg-white" >
    <div class="container space-y-24">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Proyectos artísticos</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-1 gap-16 mb-8">
          <div class= "p-0 rounded-lg shadow-sm">
            <h3 class="text-xl font-bold mb-3">Fotografía contemporánea</h3>
            <img 
            src="/uploads/fotografia-contemporanea-isaac-ramos.webp" 
            alt="fotografia-contemporanea-de-isaac-ramos"
            class="w-full h-[700px] mt-8 object-cover rounded-md transition duration-700 hover:scale-105"
            />
            <Button href="/fotografia-contemporanea" variant="outline" class="mt-8 mb-4">
          Explorar →
            </Button>
          </div>
          
        <div class="grid grid-cols-1 md:grid-cols-1 gap-16 mb-8">  
          <div class= "p-0 rounded-lg shadow-sm">
            <h3 class="text-xl font-bold mb-3">Piezas y objetos</h3>
            <img 
            src="/uploads/piezas-y-objetos-isaac-ramos.webp" 
            alt="piezas-y-objetos-isaac-ramos"
            class="w-full h-[700px] mt-8 object-cover rounded-md transition duration-700 hover:scale-105"
            />
            <Button href="/piezas-y-objetos" variant="outline" class="mt-8 mb-4">
          Explorar → 
             </Button>
          </div>
          </div>
        </div>
      </div>
    </div>
  </section>

 


  <!-- Sección de Publicaciones, Obras editadas, fanzines, libros, etc -->
  <PublicacionesList />


  <!-- Call to Action - Newsletter-->
  <section 
    class="py-20 bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(/uploads/suscribete-neswletter.webp)"
  >
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">¿Quieres saber más? ¡Tengo un newsletter!</h2>
        <p class="text-xl mb-8">
          Suscríbete al newsletter para recibir actualizaciones sobre proyectos, obras recientes, exposiciones y más procesos relacionados con mi práctica artística.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/newsletter" variant="primary" size="lg">
            Suscribirse
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>