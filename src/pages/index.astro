---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import ObrasList from "../components/Sections/ObrasList.astro";
import PublicacionesList from "../components/Sections/PublicacionesList.astro";
import Button from "../components/UI/Button.astro";
import OptimizedImage from "../components/UI/OptimizedImage.astro";
---

<BaseLayout>
  <HeroSection 
    backgroundImage="/uploads/fondo-base.webp"
  />

  <!-- Obras Destacadas-->
  <ObrasList />

   <!-- About Isaac Ramos  -->
  <section class="py-[120px] bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <OptimizedImage
            src="/uploads/isaac-ramos.webp" 
            alt="isaac-ramos-artista-visual" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
            loading="lazy"
            decoding="async"
          />
        </div>
        
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Sobre Isaac Ramos</h2>
          <p class="text-gray-700 mb-6 text-lg">
            Fotógrafo y artista visual. Integrante del colectivo Tropical Fanzine, donde se producen publicaciones independientes. Su práctica gira en torno al desapego y la resignificación de experiencias personales mediante la reconfiguración de objetos cotidianos.
                    </p>
          <p class="text-gray-700 mb-8 text-lg">
            Ha exhibido su obra en el TYPA Letterpress and Paper Art Centre de Tartú, Estonia; Carnaval L'ours Noir Mont-Louis 2026, en colaboración con Aztrosharper; y en galerías como Galería Universitaria San Francisco de Borja, Galería Casa Habitación, Galería del Centro de Artes del NorteEs parte de la colección de la fanzinoteca del Museo Universitario del Chopo y la Libre.
          </p>
          
          <div class="flex justify-center">
            <Button href="/sobre-mi">
              Ver Curriculum Vitae
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- Series fotográficas y proyectos artísticos  - Body Work - Cuerpo de Trabajo-->
 <section class="py-[150px] bg-white">
  <div class="container">
    <div class="max-w-7xl mx-auto">

      <h2 class="text-3xl md:text-4xl font-bold text-center mb-20">
        Proyectos artísticos
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">

        <!-- Fotografía -->
        <article class="group">

          <h3 class="text-2xl font-semibold text-center tracking-wide transition-all duration-500 group-hover:tracking-widest">
            Fotografía contemporánea
          </h3>

          <div class="w-14 h-px bg-black mx-auto my-6 transition-all duration-500 group-hover:w-20"></div>

          <p class="text-neutral-500 text-center max-w-md mx-auto mb-10 leading-relaxed">
            Exploraciones sobre el territorio urbano, la memoria y el objeto personal
            mediante el desapego de objetos.
          </p>

          <a
            href="/obras/fotografia-contemporanea"
            class="block px-6 overflow-hidden rounded-md"
          >
            <OptimizedImage
              src="/uploads/fotografia-contemporanea-isaac-ramos.webp"
              alt="Fotografía contemporánea de Isaac Ramos"
              class="
                w-full
                h-[560px]
                object-cover
                rounded-md
                transition-all
                duration-700
                ease-out
                group-hover:scale-[1.02]
                group-hover:shadow-xl
                group-hover:brightness-95
              "
              loading="lazy"
              decoding="async"
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 50vw"
            />
          </a>

          <div class="flex justify-center mt-10">
            <Button
              href="/obras/fotografia-contemporanea"
              variant="outline"
              class="transition-all duration-300 group-hover:px-7"
            >
              Explorar fotografía →
            </Button>
          </div>

        </article>

        <!-- Objetos -->
        <article class="group">

          <h3 class="text-2xl font-semibold text-center tracking-wide transition-all duration-500 group-hover:tracking-widest">
            Piezas y objetos
          </h3>

          <div class="w-14 h-px bg-black mx-auto my-6 transition-all duration-500 group-hover:w-20"></div>

          <p class="text-neutral-500 text-center max-w-md mx-auto mb-10 leading-relaxed">
            Objetos, ensamblajes e instalaciones que exploran la relación entre
            los materiales, el espacio y la experiencia cotidiana.
          </p>

          <a
            href="/obras/piezas-y-objetos"
            class="block px-6 overflow-hidden rounded-md"
          >
            <OptimizedImage
              src="/uploads/piezas-y-objetos-isaac-ramos.webp"
              alt="Piezas y objetos de Isaac Ramos"
              class="
                w-full
                h-[560px]
                object-cover
                rounded-md
                transition-all
                duration-700
                ease-out
                group-hover:scale-[1.02]
                group-hover:shadow-xl
                group-hover:brightness-95
              "
              loading="lazy"
              decoding="async"
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 50vw"
            />
          </a>

          <div class="flex justify-center mt-10">
            <Button
              href="/obras/piezas-y-objetos"
              variant="outline"
              class="transition-all duration-300 group-hover:px-7"
            >
              Explorar piezas →
            </Button>
          </div>

        </article>

      </div>

    </div>
  </div>
</section>