---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Button from "../../components/UI/Button.astro";

const toJsonLd = (schema: Record<string, unknown>) =>
  JSON.stringify(schema).replace(/[<>&\u2028\u2029]/g, (character) =>
    `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`
  );

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Edición de video para profesionales de la belleza",
  serviceType: "Edición de video y postproducción para profesionales de la belleza",
  description:
    "Edición de video y postproducción para lashistas, barberos, maquillistas y salones. Destaca tu trabajo con un ritmo visual premium y color grading profesional.",
  url: "https://isiramos.art/servicios/edicion-video/",
  provider: {
    "@type": "Person",
    name: "Isaac Ramos",
    url: "https://isiramos.art",
  },
  areaServed: "MX",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Edición de video para belleza",
    itemListElement: [
      "Edición de videos para Reels y TikTok",
      "Montaje de transformaciones y antes y después",
      "Color grading para piel, cabello y producto",
      "Paquetes mensuales de contenido para redes sociales",
    ].map((item) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: item,
      },
    })),
  },
};
---

<BaseLayout
  title="Edición de video y postproducción para profesionales de la belleza | Isaac Ramos"
  description="Edición de video y postproducción para lashistas, barberos, maquillistas y salones. Destaca tu trabajo con un ritmo visual premium y color grading profesional."
  canonicalUrl="https://isiramos.art/servicios/edicion-video/"
>
  <PageHeader title="Edición de video y postproducción para profesionales de la belleza" />

  <section class="container mx-auto max-w-3xl px-4 py-16 md:py-20">
    <article class="prose prose-lg max-w-none text-gray-700">
      <p>
        Tu trabajo habla por sí solo: la precisión de un delineado, la perfección de un set de
        pestañas o el acabado impecable de un corte. Pero cuando lo grabas con el celular, a
        veces la magia se pierde en un video oscuro, mal cortado o con un color que no le hace
        justicia a tu esfuerzo.
      </p>

      <p>
        No hago ediciones genéricas para redes sociales. Como artista visual, entiendo que en
        la industria de la belleza <strong>el detalle lo es todo</strong>. Mi trabajo es tomar
        el material en bruto de tu celular y darle el color, el ritmo y la textura necesarios
        para que tu portafolio (y tus clientes) vean la calidad real de tu trabajo.
      </p>
    </article>

    <div class="mt-8">
      <Button href="/contacto">Solicitar cotización para mi marca personal</Button>
    </div>

    <div class="prose prose-lg mt-16 max-w-none text-gray-700">
      <h2>¿Para quién es este servicio?</h2>
      <ul>
        <li>
          <strong>Lashistas y manicuristas:</strong> Que necesitan mostrar la textura, el brillo
          y la simetría de su trabajo en videos de alta calidad para atraer a más clientas.
        </li>
        <li>
          <strong>Maquillistas y barberos:</strong> Que buscan crear Reels y TikToks con un estilo
          cinematográfico (antes y después, procesos, transiciones) que destaquen frente a la
          competencia.
        </li>
        <li>
          <strong>Centros de estética y spas:</strong> Que quieren proyectar una imagen premium
          y limpia en sus redes sociales.
        </li>
      </ul>

      <h2>Mi Proceso de Trabajo</h2>
      <ol>
        <li>
          <strong>Briefing:</strong> Me envías tus clips (incluso si están en desorden) y me dices
          qué quieres resaltar (ej. "quiero que se vea el proceso de las pestañas" o "quiero un
          video aesthetic").
        </li>
        <li>
          <strong>Montaje y Color Grading:</strong> Aplico etalonaje (color) para que los tonos
          de piel se vean naturales, los brillos resalten y el ambiente se sienta acogedor o de
          lujo, según tu marca.
        </li>
        <li>
          <strong>Entrega:</strong> Recibes el video en formato vertical optimizado para Reels,
          TikTok o Stories.
        </li>
      </ol>
    </div>

    <div class="mt-8">
      <Button href="/contacto" variant="outline">Hablemos de tu proyecto</Button>
    </div>

    <div class="prose prose-lg mt-16 max-w-none text-gray-700">
      <h2>Preguntas Frecuentes</h2>

      <h3>¿Cuánto cuesta editar videos para redes sociales?</h3>
      <p>
        Ofrezco paquetes mensuales pensados para profesionales de la belleza. Por ejemplo, un
        paquete de 8 o 12 videos al mes. Esto te garantiza constancia en tus redes sin tener que
        preocuparte por la edición cada semana.
      </p>

      <h3>¿Qué necesitas para empezar?</h3>
      <p>
        Solo necesito tus videos originales (pueden ser grabados con tu celular), la música que
        te guste y una idea de lo que quieres mostrar. Yo me encargo del resto.
      </p>

      <h3>¿Cuánto tiempo tardas en entregar?</h3>
      <p>
        Para paquetes mensuales, coordinamos un calendario de entregas semanales. Para un video
        individual, el tiempo de entrega es de 3 a 5 días hábiles.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={toJsonLd(serviceSchema)} />
</BaseLayout>
