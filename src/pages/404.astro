---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Página no encontrada | Isaac Ramos"
  description="La página que buscas no existe o ha sido movida."
>
  <div class="min-h-[calc(100vh-8rem)] flex items-center justify-center">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center py-20">
        
        <h1 class="text-9xl md:text-[120px] font-serif font-bold mb-6 text-gray-900">
          404
        </h1>

        <div class="w-20 h-px bg-gray-900 mx-auto mb-8"></div>

        <h2 class="text-3xl md:text-4xl font-serif font-semibold mb-6 text-gray-800">
          Página no encontrada
        </h2>

        <p class="text-lg text-gray-600 mb-12 leading-relaxed max-w-xl mx-auto">
          La página que buscas no existe o ha sido movida. Verifica la URL o regresa al inicio para explorar más obras.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-4 bg-gray-900 text-white rounded-md hover:bg-gray-800 transition-colors"
          >
            Volver al inicio
          </a>

          <a
            href="/obras"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-gray-900 text-gray-900 rounded-md hover:bg-gray-50 transition-colors"
          >
            Ver obras
          </a>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
