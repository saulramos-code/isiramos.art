---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLayout from "../../layouts/PostLayout.astro";
import Button from "../../components/UI/Button.astro";
import OptimizedImage from "../../components/UI/OptimizedImage.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../utils/dateUtils";

// Generar rutas estáticas
export async function getStaticPaths() {
  const publicaciones = await getCollection("publicaciones", ({ data }) =>
    !data.draft
  );

  return publicaciones.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Publicación actual
const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = formatDate(entry.data.date);

// Buscar publicaciones relacionadas por serie
const allPublicaciones = await getCollection("publicaciones", ({ data }) =>
  !data.draft
);

const relatedPublicaciones = allPublicaciones
  .filter(
    (item) =>
      item.slug !== entry.slug &&
      item.data.series &&
      item.data.series === entry.data.series
  )
  .slice(0, 3);

---

<BaseLayout
  title={`${entry.data.title} | Isaac Ramos`}
  description={entry.data.summary}
  image={entry.data.image ? { url: entry.data.image, alt: entry.data.title } : undefined}
  type="article"
>

<PostLayout
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image ? { url: entry.data.image, alt: entry.data.title } : undefined}
  date={entry.data.date}
  author={entry.data.autor}
  tags={entry.data.tags}
  type="publicaciones"
>

<section class="grid lg:grid-cols-5 gap-20 mb-20">

    <!-- Columna izquierda -->
    <aside class="lg:col-span-2">

        <h2 class="text-3xl font-serif mb-10">
            Información
        </h2>

        <div class="space-y-8">

            <div class="pb-6 border-b border-gray-200">
                <p class="uppercase tracking-[0.2em] text-xs text-gray-500 mb-2">
                    Autor: {entry.data.autor}
                </p>
            {
               <p class="uppercase tracking-[0.2em] text-xs text-gray-500 mb-2">
                            Serie: {entry.data.series}
              </p>
            }

            {
              <p class="uppercase tracking-[0.2em] text-xs text-gray-500 mb-2">
                  Formato: {entry.data.formato}
              </p>
            }

            {

              <p class="uppercase tracking-[0.2em] text-xs text-gray-500 mb-2">
                  Categoría: {entry.data.categoria}
              </p>
            }

            {
                entry.data.tags && (

                    <div>

                        <p class="uppercase tracking-[0.2em] text-xs text-gray-500 mb-4">
                            Etiquetas: 
                        </p>

                        <div class="flex flex-wrap gap-3">

                            {
                                entry.data.tags.map(tag => (

                                    <span
                                        class="px-4 py-2 rounded-full border border-gray-300 text-sm hover:bg-black hover:text-white transition duration-300"
                                    >
                                        {tag}
                                    </span>

                                ))
                            }

                        </div>

                    </div>

                )
            }

        </div>

    </aside>

    <!-- Columna derecha -->

    <div class="lg:col-span-3">

        <h2 class="text-3xl font-serif mb-10">
            Sinopsis
        </h2>

        {
            entry.data.summary ? (

                <div class="prose prose-lg max-w-none">

                    <p class="leading-relaxed text-gray-700 text-lg">
                        {entry.data.summary}
                    </p>

                </div>

            ) : (

                <p class="text-gray-500 italic">
                    Esta publicación aún no cuenta con una sinopsis.
                </p>

            )
        }

    </div>

</section>

</div>

    <!-- Contenido -->
    <article
      class="prose prose-lg max-w-3xl mx-auto
      prose-headings:font-serif
      prose-headings:text-gray-900
      prose-p:text-gray-700
      prose-p:leading-relaxed
      prose-a:text-primary-600
      hover:prose-a:text-primary-700
      prose-img:rounded-lg"
    >
      <Content />
    </article>

    <!-- Video -->
    {
      entry.data.videoUrl && (
        <section class="mt-16">
          <h2 class="text-2xl font-semibold mb-6">
            Video
          </h2>

          <div class="aspect-video rounded-lg overflow-hidden shadow-lg">
            <iframe
              src={entry.data.videoUrl}
              title={entry.data.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
            ></iframe>
          </div>
        </section>
      )
    }

    <!-- Publicaciones relacionadas -->
    {
      relatedPublicaciones.length > 0 && (

        <section class="mt-24 border-t border-gray-200 pt-16">

          <h2 class="text-3xl font-serif mb-10">
            Más publicaciones de esta serie
          </h2>

          <div class="grid gap-8 md:grid-cols-3">

            {
              relatedPublicaciones.map((publicacion) => (

                <a
                  href={`/publicaciones/${publicacion.slug}`}
                  class="group"
                >

                  {
                    publicacion.data.image && (
                      <OptimizedImage
                        src={publicacion.data.image}
                        alt={publicacion.data.title}
                        class="aspect-[4/5] w-full object-cover rounded-lg mb-5 transition duration-500 group-hover:opacity-90 group-hover:scale-[1.02]"
                        loading="lazy"
                        decoding="async"
                        widths={[320, 640, 960]}
                        sizes="(max-width: 768px) 100vw, 33vw"
                      />
                    )
                  }

                  <p class="text-sm uppercase tracking-widest text-gray-500 mb-2">
                    {formatDate(publicacion.data.date)}
                  </p>

                  <h3
                    class="text-xl font-semibold transition-colors group-hover:text-primary-600"
                  >
                    {publicacion.data.title}
                  </h3>

                  {
                    publicacion.data.summary && (
                      <p class="mt-3 text-gray-600 text-sm line-clamp-3">
                        {publicacion.data.summary}
                      </p>
                    )
                  }

                </a>

              ))
            }

          </div>

        </section>

      )
    }

    <!-- Navegación -->
    <div class="mt-24 border-t border-gray-200 pt-10 flex justify-center">

      <Button
        href="/publicaciones"
        variant="outline"
      >
        ← Volver a publicaciones
      </Button>

    </div>

  </PostLayout>

</BaseLayout>
