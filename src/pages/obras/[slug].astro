---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLayout from "../../layouts/PostLayout.astro";
import Button from "../../components/UI/Button.astro";
import ObraGallery from "../../components/Obras/ObraGallery.astro";
import { getCollection } from "astro:content";

// Generate static paths for all works
export async function getStaticPaths() {
  try {
    const ObrasEntries = await getCollection("obras", ({ data }) => {
      return !data.draft;
    });

    return ObrasEntries.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error(error);
    throw error;
  }
}

// Get the work data
const { entry } = Astro.props;
const { Content } = await entry.render();

// Get all published works
const allWorks = (
  await getCollection("obras", ({ data }) => {
    return !data.draft;
  })
).sort((a, b) => b.data.year - a.data.year);

// Current work position
const currentIndex = allWorks.findIndex(
  (item) => item.slug === entry.slug
);

// Previous work
const previous =
  currentIndex > 0
    ? allWorks[currentIndex - 1]
    : null;

// Next work
const next =
  currentIndex < allWorks.length - 1
    ? allWorks[currentIndex + 1]
    : null;

// Gallery label
const galleryLabel =
  entry.data.type === "video"
    ? "Stills"
    : "Imágenes";
---

<BaseLayout
  title={
    entry.data.seoTitle ||
    `${entry.data.title} (${entry.data.year}) | Isaac Ramos`
  }
  description={
    entry.data.seoDescription ||
    `${entry.data.title} (${entry.data.year}), obra de Isaac Ramos.`
  }
  image={{
    url: entry.data.image,
    alt: `${entry.data.title} (${entry.data.year})`
  }}
  type="article"
  artwork={{
    name: entry.data.title,
    year: entry.data.year
  }}
>
  <PostLayout
    title={entry.data.title}
    description={
      entry.data.seoDescription ||
      `${entry.data.title} (${entry.data.year}), obra de Isaac Ramos.`
    }
    image={{
      url: entry.data.image,
      alt: entry.data.title
    }}
    tags={entry.data.tags}
    type="obras"
  >

    <!-- =====================================================
         OBRA
    ====================================================== -->

    <article
      class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900 prose-a:text-primary-600 hover:prose-a:text-primary-700"
    >
      <Content />
    </article>


    <!-- =====================================================
         GALERÍA / STILLS
    ====================================================== -->

    {
      entry.data.gallery &&
      entry.data.gallery.length > 0 && (
        <ObraGallery
          images={entry.data.gallery}
          label={galleryLabel}
        />
      )
    }


    <!-- =====================================================
         EXPLORAR LA COLECCIÓN
    ====================================================== -->

    <section class="mt-32 border-t border-gray-200 pt-20">
      <div class="mb-16 text-center">
        <p class="text-xs uppercase tracking-[0.35em] text-gray-500">
          Explorar la colección
        </p>
      </div>

      <div class="grid gap-12 md:grid-cols-2">

        {
          previous && (
            <a
              href={`/obras/${previous.slug}`}
              class="group"
              aria-label={`Ver obra anterior: ${previous.data.title}`}
            >
              <p class="mb-4 text-sm uppercase tracking-[0.3em] text-gray-400">
                ← Obra anterior
              </p>

              <h3 class="text-2xl font-semibold group-hover:underline">
                {previous.data.title}
              </h3>

              <p class="mt-3 text-gray-500">
                {previous.data.year}
              </p>
            </a>
          )
        }

        {
          next && (
            <a
              href={`/obras/${next.slug}`}
              class="group text-right"
              aria-label={`Ver obra siguiente: ${next.data.title}`}
            >
              <p class="mb-4 text-sm uppercase tracking-[0.3em] text-gray-400">
                Obra siguiente →
              </p>

              <h3 class="text-2xl font-semibold group-hover:underline">
                {next.data.title}
              </h3>

              <p class="mt-3 text-gray-500">
                {next.data.year}
              </p>
            </a>
          )
        }

      </div>
    </section>


    <!-- =====================================================
         BOTONES
    ====================================================== -->

    <div class="mt-12 flex flex-wrap gap-4">

      <Button href="/obras" variant="outline">
        ← Volver a Obras
      </Button>

      <Button href="/contacto" variant="outline">
        Contacto
      </Button>

    </div>

  </PostLayout>


  <!-- =====================================================
       GOOGLE ANALYTICS — OBRA
  ====================================================== -->

  <script
    is:inline
    define:vars={{ obra: entry.data.title }}
  >
    window.dataLayer = window.dataLayer || [];

    function gtag(...args) {
      window.dataLayer.push(args);
    }

    gtag("event", "obra_view", {
      obra: obra,
    });

    fbq("trackCustom", "ObraView", {
      obra: obra,
    });
  </script>

</BaseLayout>