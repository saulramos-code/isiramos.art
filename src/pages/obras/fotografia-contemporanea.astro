---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import OptimizedImage from "../../components/UI/OptimizedImage.astro";
import { getCollection } from "astro:content";

const todasLasObras = await getCollection("obras", ({ data }) => {
  return !data.draft;
});

// Obras relacionadas con fotografía contemporánea
const fotografias = todasLasObras
  .filter((obra) => {
    const tags =
      obra.data.tags?.map((tag) =>
        tag.toLowerCase().trim()
      ) || [];

    return tags.some((tag) =>
      [
        "fotografia",
        "fotografía",
        "fotografia contemporanea",
        "fotografía contemporánea",
        "foto",
        "photography"
      ].includes(tag)
    );
  })
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Fotografía contemporánea | Isaac Ramos"
  description="Fotografía contemporánea de Isaac Ramos. Proyectos fotográficos que exploran territorio, memoria, objetos y relaciones con el entorno."
>

  <!-- Encabezado -->
  <PageHeader
    title="Fotografía contemporánea"
  />


  <!-- Introducción -->
  <section class="pt-8 pb-20">
    <div class="container">

      <div class="max-w-3xl">

        <p class="text-xl md:text-2xl leading-relaxed text-gray-700">
          Una práctica fotográfica centrada en el territorio, los objetos
          cotidianos, la memoria y las relaciones entre el ser humano y su entorno.
        </p>

      </div>

    </div>
  </section>


  <!-- Imagen principal -->
  <section class="pb-24">
    <div class="container">

      <div class="max-w-6xl mx-auto">

        <div class="overflow-hidden rounded-md group">

          <OptimizedImage
            src="/uploads/fotografia-contemporanea-isaac-ramos.webp"
            alt="Fotografía contemporánea de Isaac Ramos"
            class="w-full h-[450px] md:h-[650px] object-cover
                   transition duration-700
                   group-hover:scale-[1.02]
                   group-hover:brightness-95"
                 loading="eager"
                 fetchpriority="high"
                 decoding="async"
                 widths={[480, 800, 1200, 1600]}
                 sizes="(max-width: 768px) 100vw, 1200px"
          />

        </div>

      </div>

    </div>
  </section>


  <!-- Archivo fotográfico -->
  <section class="pb-32">
    <div class="container">

      <!-- Encabezado -->
      <div class="flex items-end justify-between mb-12">

        <div>

          <p class="text-sm uppercase tracking-[0.2em] text-gray-500 mb-3">
            Archivo
          </p>

          <h2 class="heading-h2">
            Fotografía
          </h2>

        </div>

        <p class="hidden md:block text-sm text-gray-500">
          {fotografias.length}
          {fotografias.length === 1 ? "proyecto" : "proyectos"}
        </p>

      </div>


      {fotografias.length > 0 ? (

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">

          {fotografias.map((fotografia) => (

            <a
              href={`/obras/${fotografia.slug}`}
              class="group block"
            >

              <!-- Imagen -->
              <div class="overflow-hidden rounded-md bg-gray-100">

                <OptimizedImage
                  src={fotografia.data.image}
                  alt={fotografia.data.title}
                  loading="lazy"
                  decoding="async"
                  widths={[320, 640, 960]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="w-full aspect-[4/3] object-cover
                         transition duration-700
                         group-hover:scale-[1.02]
                         group-hover:brightness-95"
                />

              </div>


              <!-- Información -->
              <div class="pt-5">

                <div class="flex items-center justify-between mb-3">

                  <span class="text-sm text-gray-500">
                    {fotografia.data.year}
                  </span>

                  <span
                    class="text-sm text-gray-400
                           opacity-0
                           group-hover:opacity-100
                           transition-opacity duration-300"
                  >
                    Ver proyecto →
                  </span>

                </div>


                <h3 class="obra-title text-gray-900 group-hover:text-primary-700 transition-colors duration-300">
                  {fotografia.data.title}
                </h3>


                {fotografia.data.tags &&
                  fotografia.data.tags.length > 0 && (

                  <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4">

                    {fotografia.data.tags
                      .filter((tag) =>
                        ![
                          "fotografia",
                          "fotografía",
                          "foto",
                          "photography"
                        ].includes(tag.toLowerCase())
                      )
                      .slice(0, 4)
                      .map((tag) => (

                        <span
                          class="text-xs uppercase tracking-wider
                                 text-gray-500"
                        >
                          {tag}
                        </span>

                      ))}

                  </div>

                )}

              </div>

            </a>

          ))}

        </div>

      ) : (

        <!-- Empty state -->
        <div class="py-20 text-center border-t border-gray-200">

          <p class="text-gray-500">
            Próximamente se incorporarán proyectos fotográficos.
          </p>

        </div>

      )}

    </div>
  </section>

</BaseLayout>
