---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import OptimizedImage from "../components/UI/OptimizedImage.astro";
---

  <!-- Realizar la meta descripción -->
<BaseLayout
  title="Sobre el artista visual | Isaac Ramos"  
  description="Soy artista visual y fotográfo, mi trabajo es la mezcla de la intervención fotografía y la materialización en objetos cotidianos y viejos para que sean destruídos. Mi trabajo ha sido expuesto en múltiples galerías y festivales internacionales."
>



   <!-- Semblanza -->
  <div class="max-w-5xl mx-auto mb-24 py-[120px]">
    <h1 class="font-serif text-4xl md:text-6xl mb-4">
      Sobre Isaac Ramos
    </h1>
    <div class="w-24 h-px bg-texto-950"></div>
 <div class="container ">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center py-[48px]">
        <div>
          <p class="text-xl text-gray-700 mb-8">
            Fotógrafo y artista visual. Integrante del colectivo Tropical Fanzine, donde se producen publicaciones independientes. Su práctica gira en torno al desapego y la resignificación de experiencias personales mediante la reconfiguración de objetos cotidianos.
          </p>
          <p class="text-xl text-gray-700 mb-8">
            Ha exhibido su obra en el TYPA Letterpress and Paper Art Centre de Tartú, Estonia; Carnaval L'ours Noir Mont-Louis 2026, en colaboración con Aztrosharper; y en galerías como Galería Universitaria San Francisco de Borja, Galería Casa Habitación, Galería del Centro de Artes del Norte. Es parte de la colección de la fanzinoteca del Museo Universitario del Chopo y la Libre.
          </p>
        </div>
        
        <div>
          <OptimizedImage
            src="/uploads/isaac-ramos-artista-visual.webp" 
            alt="isaac-ramos-artista-visual" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            widths={[320, 640, 960]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Semblaza -->
  <section class="py-[24px]">
   
  </section>
  
   <!-- CV -->
  <section class="mb-24 bg-white">
  <div class="container">

    <!-- Imagen -->
    <div class="mb-24">
      <OptimizedImage
        src="/uploads/caminantes-en-la-carretera-obra-de-isaac-ramos.webp"
        alt="Caminantes en la carretera, obra de Isaac Ramos"
        class="w-full h-[500px] md:h-[650px] object-cover rounded-lg"
        loading="lazy"
        decoding="async"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 768px) 100vw, 1200px"
      />
    </div>

    <!-- Título -->
    <div class="max-w-5xl mx-auto mb-24">
      <h2 class="font-serif text-4xl md:text-6xl mb-4">
        Currículum
      </h2>

      <div class="w-24 h-px bg-texto-950"></div>
    </div>

    <!-- PREMIOS -->
    <section class="max-w-5xl mx-auto mb-32">
      <h3 class="font-serif text-3xl md:text-4xl mb-16">
        Premios y reconocimientos
      </h3>

      <div class="space-y-16">

        <div class="grid md:grid-cols-[120px_1fr] gap-8">
          <div>
            <h4 class="font-serif text-3xl">2026</h4>
          </div>

          <ul class="space-y-4 text-lg leading-relaxed text-texto-700">
            <li class="pl-4 border-l border-texto-300">
              Ganador del premio <em>“Best Experimental Film”</em> en el Carnaval
              L'Ours Noir Mont-Louis 2026. Colaboración con Aztrosharper.
              Mont-Louis, Francia.
            

            <li class="pl-4 border-l border-texto-300">
              Nominado en la categoría <em>“Best Student Animation”</em>.
              Carnaval L'Ours Noir Mont-Louis 2026.
            </li>

            <li class="pl-4 border-l border-texto-300">
              Seleccionado para la categoría <em>Cineminuto</em>o en el Festival Pixeatl 2026.
              Guadalajara, Jalisco.
            </li>

            <li class="pl-4 border-l border-texto-300">
              Seleccionado en el concurso <em>El Lado C de la Animación</em>.
              Morelia, Michoacán.
            </li>
          </ul>
        </div>

        <div class="grid md:grid-cols-[120px_1fr] gap-8">
          <div>
            <h4 class="font-serif text-3xl">2025</h4>
          </div>

          <ul class="space-y-4 text-lg leading-relaxed text-texto-700">
            <li class="pl-4 border-l border-texto-300">
              Primer lugar en el concurso <em>Hojas de Otoño 2025</em>.
              Universidad Iberoamericana Torreón.
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- EXPOSICIONES COLECTIVAS -->
    <section class="max-w-5xl mx-auto mb-32">
      <h3 class="font-serif text-3xl md:text-4xl mb-16">
        Exposiciones colectivas
      </h3>

      <div class="grid md:grid-cols-[120px_1fr] gap-8">
        <div>
          <h4 class="font-serif text-3xl">2025</h4>
        </div>

        <ul class="space-y-4 text-lg leading-relaxed text-texto-700">
          <li class="pl-4 border-l border-texto-300">
            Concurso de Arte <em>Linoollõikekonkurss 2025</em>.
            TYPA Letterpress and Paper Art Centre. Tartú, Estonia.
          </li>

          <li class="pl-4 border-l border-texto-300">
            <em>Hojas de Otoño 2025. Libro-Objeto. </em>
            Galería Universitaria San Francisco de Borja. Torreón, Coahuila.
          </li>

          <li class="pl-4 border-l border-texto-300">
            <em>Al ras del suelo.</em>
            Galería Casa Habitación.
            Curaduría de Norberto Treviño. Torreón, Coahuila.
          </li>

          <li class="pl-4 border-l border-texto-300">
            <em>Nostalgia de un Futuro Fracasado.</em>
            Centro de Artes del Norte. Torreón, Coahuila.
          </li>
        </ul>
      </div>
    </section>

    <!-- EXPOSICIONES INDIVIDUALES -->
    <section class="max-w-5xl mx-auto mb-32">
      <h3 class="font-serif text-3xl md:text-4xl mb-16">
        Exposiciones individuales
      </h3>

      <div class="grid md:grid-cols-[120px_1fr] gap-8">
        <div>
          <h4 class="font-serif text-3xl">2026</h4>
        </div>

        <ul class="space-y-4 text-lg leading-relaxed text-texto-700">
          <li class="pl-4 border-l border-texto-300">
            <em>Bancas y paredes</em>.
            Aeropuerto Internacional Francisco Sarabia.
            Torreón, Coahuila.
          </li>
        </ul>
      </div>
    </section>

    <!-- BECAS -->
    <section class="max-w-5xl mx-auto">
      <h3 class="font-serif text-3xl md:text-4xl mb-16">
        Becas y apoyos
      </h3>

      <div class="grid md:grid-cols-[120px_1fr] gap-8">
        <div>
          <h4 class="font-serif text-3xl">2026</h4>
        </div>

        <ul class="space-y-4 text-lg leading-relaxed text-texto-700">
          <li class="pl-4 border-l border-texto-300">
            <em>Programa de Asesorías de Proyectos Culturales</em>.
            Centro Nacional de las Artes. México.
          </li>
        </ul>
      </div>
    </section>

  </div>
</section>

</BaseLayout>