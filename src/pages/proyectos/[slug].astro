---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Button from "../../components/UI/Button.astro";
import ProyectoGallery from "../../components/Proyectos/ProyectoGallery.astro";
import OptimizedImage from "../../components/UI/OptimizedImage.astro";
import { getCollection } from "astro:content";

// Generate static paths for all proyectos
export async function getStaticPaths() {
  try {
    const proyectosEntries = await getCollection("proyectos", ({ data }) => {
      return !data.draft;
    });

    return proyectosEntries.map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    // If the collection doesn't exist yet, return an empty array
    return [];
  }
}

// Get the proyectos data
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
  title={`${entry.data.name} | Proyectos | Isaac Ramos`}
  description={entry.data.summary}
  image={entry.data.logo ? { url: entry.data.logo, alt: entry.data.name } : undefined}
>
  <PageHeader 
    title={entry.data.name} 
  />
  
  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900">
            <Content />
          </div>
        </div>
        
        <!-- Sidebar -->
        <div>
          <div class="bg-gray-50 p-6 rounded-lg shadow-sm sticky top-24">
            {
              entry.data.logo && (
                <div class="mb-6 flex justify-center">
                  <OptimizedImage
                    src={entry.data.logo} 
                    alt={entry.data.name} 
                    class="max-h-48 w-auto"
                    loading="lazy"
                    decoding="async"
                    widths={[320, 640, 960]}
                    sizes="(max-width: 768px) 100vw, 320px"
                  />
                </div>
              )
            }
            
            <h3 class="text-xl font-bold mb-4">Información del Proyecto</h3>
            
            <div class="space-y-4 mb-6">
              {entry.data.year && (
                <div>
                  <h4 class="font-bold text-gray-700">Año</h4>
                  <p>{entry.data.year}</p>
                </div>
              )}
              {entry.data.coordinator && (
                <div>
                  <h4 class="font-bold text-gray-700">Colaboradores</h4>
                  <p>{entry.data.coordinator}</p>
                </div>
              )}
              
              {entry.data.contact && (
                <div>
                  <h4 class="font-bold text-gray-700">Contacto</h4>
                  {entry.data.contact.includes('@') ? (
                    <a href={`mailto:${entry.data.contact}`} class="text-primary-600 hover:text-primary-700">
                      {entry.data.contact}
                    </a>
                  ) : (
                    <p>{entry.data.contact}</p>
                  )}
                </div>
              )}
              
              {entry.data.schedule && (
                <div>
                  <h4 class="font-bold text-gray-700">Período</h4>
                  <p>{entry.data.schedule}</p>
                </div>
              )}
            </div>
            
            <div class="flex flex-col space-y-3">
              <Button href="/contacto?subject=Consulta+de+proyecto" variant="primary">
                Hacer consulta
              </Button>

              <Button href="/proyectos" variant="outline">
                Volver a proyectos
              </Button>

              {
                entry.data.gallery && entry.data.gallery.length > 0 && (
                  <button
                    class="w-full text-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors"
                    id="open-gallery-btn"
                    type="button"
                  >
                    Ver imágenes del proyecto
                  </button>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    entry.data.gallery && entry.data.gallery.length > 0 && (
      <ProyectoGallery images={entry.data.gallery} />
    )
  }

  <script is:inline>
    const openBtn = document.getElementById("open-gallery-btn");

    if (openBtn) {
      openBtn.addEventListener("click", () => {
        if (window.__openProyectoGallery) {
          window.__openProyectoGallery();
        }
      });
    }
  </script>
</BaseLayout>