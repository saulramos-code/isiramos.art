---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import OptimizedImage from "../../components/UI/OptimizedImage.astro";
import { getCollection } from "astro:content";

// Fetch all proyectos
const all = await getCollection("proyectos", ({ data }) =>
  !data.draft
);

const proyectosFotografia = all
  .filter((proyecto) => proyecto.data.categoria === "fotografia")
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.data.name.localeCompare(b.data.name));

const proyectosArteObjeto = all
  .filter((proyecto) => proyecto.data.categoria === "arte-objeto")
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.data.name.localeCompare(b.data.name));

---

<BaseLayout 
  title="Proyectos | Isaac Ramos 2026"  
  description="Series fotográficas, arte objeto y publicaciones de Isaac Ramos.">

  <section class="py-[120px] bg-white">
  <!--Título-->
  <div class="container grid lg:grid-cols-2 gap-20 items-center">
    <!-- Encabezado -->
    <div class="max-w-4xl py-[92px]">
      <h1 class="font-serif text-5xl md:text-7xl text-texto-950 mb-8">
        Proyectos
      </h1>

      <div class="w-24 h-px bg-texto-950 mb-8"></div>

      <p class="max-w-2xl text-lg md:text-xl leading-relaxed text-texto-600">
        Series fotográficas, arte objeto y publicaciones que exploran
        el desapego y las relaciones afectivas que construimos con los
        objetos cotidianos.
      </p>
    </div>

    <div>
        <OptimizedImage
          src="/uploads/proyectos-isaac-ramos.webp"
          alt="Proyectos de Isaac Ramos"
          class="w-full h-[450px] object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
        />
    </div>
  </div>  
</section>

<section class="py-[60px] group">
  <div class="container gap-20"> 
    <!-- Series fotográficas -->
    <article>
      <p class="text-sm uppercase tracking-[0.25em] text-texto-500 mb-4">
          2024-2026
      </p>
      <h2 class="font-serif text-3xl md:text-5xl text-texto-950 mb-10 transition-colors duration-300 group-hover:text-naranja-100">
        <a href="/proyectos">Fotografía contemporánea</a>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {proyectosFotografia.length > 0 ? (
          proyectosFotografia.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="g-white rounded-lg shadow flex flex-col overflow-hidden hover:shadow-lg transition min-h-[370px]"
            >
              {proyecto.data.logo && (
                <div class="w-full h-[200px] overflow-hidden">
                  <OptimizedImage
                    src={proyecto.data.logo}
                    alt={proyecto.data.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    widths={[320, 640, 960]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                  />
                </div>
              )}

              <div class="p-4 flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="text-xl font-semibold mb-2">{proyecto.data.name}</h3>
                  {proyecto.data.year && (
                    <p class="mb-2 text-xs uppercase tracking-[0.2em] text-gray-500">
                      {proyecto.data.year}
                    </p>
                  )}
                  <p class="text-gray-700">{proyecto.data.summary}</p>
                </div>
              </div>
            </a>
          ))
        ) : (
          <p class="text-gray-600">No hay proyectos de fotografía contemporánea activos.</p>
        )}
      </div>
    </article>
  </div>
</section> 

<section class="py-[60px] group">
  <div class="container gap-20"> 
    <article>
      <p class="text-sm uppercase tracking-[0.25em] text-texto-500 mb-4">
          2025-2026
      </p>
      <h2 class="font-serif text-3xl md:text-5xl text-texto-950 mb-10 transition-colors duration-300 group-hover:text-naranja-100">
        <a href="/proyectos">Arte objeto</a>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {proyectosArteObjeto.length > 0 ? (
          proyectosArteObjeto.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="g-white rounded-lg shadow flex flex-col overflow-hidden hover:shadow-lg transition min-h-[370px]"
            >
              {proyecto.data.logo && (
                <div class="w-full h-[200px] overflow-hidden">
                  <OptimizedImage
                    src={proyecto.data.logo}
                    alt={proyecto.data.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    widths={[320, 640, 960]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                  />
                </div>
              )}

              <div class="p-4 flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="text-xl font-semibold mb-2">{proyecto.data.name}</h3>
                  {proyecto.data.year && (
                    <p class="mb-2 text-xs uppercase tracking-[0.2em] text-gray-500">
                      {proyecto.data.year}
                    </p>
                  )}
                  <p class="text-gray-700">{proyecto.data.summary}</p>
                </div>
              </div>
            </a>
          ))
        ) : (
          <p class="text-gray-600">No hay proyectos de arte objeto activos.</p>
        )}
      </div>
    </article>
  </div>
</section> 

</BaseLayout>
