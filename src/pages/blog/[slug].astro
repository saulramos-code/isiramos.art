---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLayout from "../../layouts/PostLayout.astro";
import { getCollection } from "astro:content";

// =====================================================
// STATIC PATHS
// =====================================================

export async function getStaticPaths() {
  try {
    const blogEntries = await getCollection("blog", ({ data }) => {
      return !data.draft;
    });

    return blogEntries.map((entry) => ({
      params: {
        slug: entry.slug,
      },
      props: {
        entry,
      },
    }));
  } catch (error) {
    console.error("Error fetching blog collection:", error);
    return [];
  }
}


// =====================================================
// CURRENT POST
// =====================================================

const { entry } = Astro.props;

const { Content } = await entry.render();


// =====================================================
// RELATED POSTS
// =====================================================

const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

const postTags = entry.data.tags ?? [];

const relatedPosts =
  postTags.length > 0
    ? allPosts
        .filter(
          (post) =>
            post.slug !== entry.slug &&
            post.data.tags.some((tag) => postTags.includes(tag))
        )
        .sort((a, b) => {
          const aMatchCount = a.data.tags.filter((tag) =>
            postTags.includes(tag)
          ).length;

          const bMatchCount = b.data.tags.filter((tag) =>
            postTags.includes(tag)
          ).length;

          return bMatchCount - aMatchCount;
        })
        .slice(0, 3)
    : [];


// =====================================================
// SOCIAL URLS
// =====================================================

const currentURL = Astro.url.toString();

const facebookShareURL =
  `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentURL)}`;

const twitterShareURL =
  `https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(currentURL)}`;

const emailShareURL =
  `mailto:?subject=${encodeURIComponent(entry.data.title)}&body=${encodeURIComponent(
    `I thought you might be interested in this article: ${currentURL}`
  )}`;
---

<BaseLayout
  title={`${entry.data.title} | Blog | Isaac Ramos`}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
>
  <PostLayout
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.image}
    date={entry.data.pubDate}
    author={entry.data.author}
    tags={entry.data.tags}
    type="blog"
  >

    <!-- =====================================================
         BLOG CONTENT
    ====================================================== -->

    <article
      class="
        prose
        prose-lg
        max-w-none
        prose-headings:text-gray-900
        prose-h1:text-3xl
        prose-h2:text-2xl
        prose-h3:text-xl
        prose-h4:text-lg
        prose-p:text-gray-700
        prose-li:text-gray-700
        prose-strong:text-gray-900
        prose-a:text-primary-600
        hover:prose-a:text-primary-700
      "
    >
      <Content />
    </article>


    <!-- =====================================================
         SOCIAL SHARING
    ====================================================== -->

    <div class="mt-12 border-t border-gray-200 py-6">

      <h3 class="mb-4 text-lg font-bold">
        Share This Post
      </h3>

      <div class="flex space-x-4">

        <!-- Facebook -->

        <a
          href={facebookShareURL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 transition-colors hover:text-blue-600"
          aria-label="Share on Facebook"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>


        <!-- Twitter / X -->

        <a
          href={twitterShareURL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 transition-colors hover:text-blue-400"
          aria-label="Share on Twitter"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723 10.03 10.03 0 01-3.127 1.184 4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
          </svg>
        </a>


        <!-- Email -->

        <a
          href={emailShareURL}
          class="text-gray-600 transition-colors hover:text-red-500"
          aria-label="Share via Email"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
        </a>

      </div>
    </div>


    <!-- =====================================================
         RELATED POSTS
    ====================================================== -->

    {
      relatedPosts.length > 0 && (
        <section class="mt-12">

          <h2 class="mb-6 text-2xl font-bold">
            Related Posts
          </h2>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">

            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="block rounded-lg bg-gray-50 p-4 transition-colors hover:bg-gray-100"
              >

                <h3 class="mb-2 font-bold">
                  {post.data.title}
                </h3>

                <p class="mb-2 text-sm text-gray-600">
                  By {post.data.author}
                </p>

                <span class="text-sm font-medium text-primary-600">
                  Read More →
                </span>

              </a>
            ))}

          </div>

        </section>
      )
    }


    <!-- =====================================================
         BACK TO BLOG
    ====================================================== -->

    <div class="mt-12">

      <a
        href="/blog"
        class="inline-flex items-center text-primary-600 hover:text-primary-700"
      >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="mr-2 h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>

        Back to All Posts

      </a>

    </div>

  </PostLayout>
</BaseLayout>