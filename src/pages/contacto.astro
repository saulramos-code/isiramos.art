---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto | Isaac Ramos"
  description="Contacto con Isaac Ramos. Información para adquisiciones de obras, servicios fotográficos y colaboraciones artísticas."
>

  <section class="py-[96px] md:py-[120px]">
    <div class="container mx-auto max-w-4xl">
      <div class="space-y-12 md:space-y-16">
        <header class="space-y-6 md:space-y-8">
          <h1 class="text-4xl font-bold tracking-[-0.04em] text-black md:text-6xl">
            Contacto
          </h1>

          <p class="max-w-2xl text-lg leading-relaxed text-gray-600 md:text-xl">
            Para adquirir una obra, contratar servicios fotográficos,
            organizar exposiciones o colaborar en proyectos.
          </p>

          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
            <a
              href="https://wa.me/528712665096?text=Hola%2C%20Isaac.%20Vi%20tu%20p%C3%A1gina%20de%20contacto%20en%20isiramos.art%20y%20me%20gustar%C3%ADa%20hacer%20una%20consulta."
              data-analytics-event="whatsapp_click"
              class="inline-flex items-center justify-center rounded-md bg-black px-6 py-3.5 text-center text-sm font-medium tracking-[0.08em] text-white uppercase transition hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2"
            >
              Adquirir una obra
            </a>

            <a
              href="mailto:contacto@isiramos.art"
              data-analytics-event="email_click"
              class="inline-flex items-center justify-center rounded-md border border-black px-6 py-3.5 text-center text-sm font-medium tracking-[0.08em] text-black uppercase transition hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2"
            >
              Contactar por correo
            </a>
          </div>
        </header>

        <div class="border-t border-black/10 pt-10 md:pt-14">
          <div class="mx-auto max-w-3xl">
            <h2 class="text-2xl font-bold tracking-[-0.03em] text-black md:text-3xl">
              ¿Tienes otra consulta?
            </h2>

            <form
              method="POST"
              action="https://formspree.io/f/xppajpkj"
              data-analytics-form="contact"
              class="mt-8 space-y-6"
            >
              <div>
                <label
                  for="nombre"
                  class="mb-1 block text-sm font-medium text-gray-700"
                >
                  Nombre completo
                </label>

                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  autocomplete="name"
                  class="w-full rounded-md border border-gray-300 px-4 py-3 focus:border-black focus:outline-none focus:ring-1 focus:ring-black"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="mb-1 block text-sm font-medium text-gray-700"
                >
                  Correo electrónico
                </label>

                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-md border border-gray-300 px-4 py-3 focus:border-black focus:outline-none focus:ring-1 focus:ring-black"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label
                  for="subject"
                  class="mb-1 block text-sm font-medium text-gray-700"
                >
                  Asunto
                </label>

                <select
                  id="subject"
                  name="subject"
                  class="w-full rounded-md border border-gray-300 px-4 py-3 focus:border-black focus:outline-none focus:ring-1 focus:ring-black"
                >
                  <option value="">
                    Selecciona una opción
                  </option>

                  <option value="compra-obra">
                    Adquirir una obra
                  </option>

                  <option value="fotografia">
                    Servicio fotográfico
                  </option>

                  <option value="exposicion">
                    Exposición, galería o museo
                  </option>

                  <option value="prensa">
                    Entrevista o prensa
                  </option>

                  <option value="colaboracion">
                    Colaboración artística
                  </option>

                  <option value="editorial">
                    Proyecto editorial
                  </option>

                  <option value="otro">
                    Otro asunto
                  </option>
                </select>
              </div>

              <div>
                <label
                  for="mensaje"
                  class="mb-1 block text-sm font-medium text-gray-700"
                >
                  Mensaje
                </label>

                <textarea
                  id="mensaje"
                  name="mensaje"
                  required
                  rows="5"
                  class="w-full resize-none rounded-md border border-gray-300 px-4 py-3 focus:border-black focus:outline-none focus:ring-1 focus:ring-black"
                  placeholder="Cuéntame más detalles de tu consulta..."
                ></textarea>
              </div>

              <input
                type="hidden"
                name="_subject"
                value="Consulta desde la web de Isaac Ramos"
              />

              <input
                type="text"
                name="_gotcha"
                class="hidden"
                tabindex="-1"
                autocomplete="off"
              />

              <button
                type="submit"
                class="mt-2 rounded-md bg-black px-6 py-3 text-sm font-medium tracking-[0.08em] text-white uppercase transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2"
              >
                Enviar consulta
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>