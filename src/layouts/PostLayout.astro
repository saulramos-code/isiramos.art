---
import PageHeader from "../components/Sections/PageHeader.astro";
import OptimizedImage from "../components/UI/OptimizedImage.astro";

export interface Props {
  title: string;
  description?: string;
  image?: {
    url: string;
    alt: string;
  };
  date?: Date;
  author?: string;
  tags?: string[];
  type?: "publicaciones" | "obras" | "blog" | "proyectos";
}

const {
  title,
  description,
  image,
  date,
  author,
  tags = [],
  type = "blog",
} = Astro.props;
---

{type === "blog" && (
  <div
    id="reading-progress"
    class="fixed left-0 top-0 z-50 h-[3px] w-0 bg-black"
    aria-hidden="true"
  />
)}

<PageHeader title={title} />

<div class="container py-8">
  <div class="mx-auto max-w-3xl">

    <!-- Imagen principal -->
    {
      image && (
        <div class="mb-8 overflow-hidden rounded-lg">
          <OptimizedImage
            src={image.url}
            alt={image.alt}
            class="h-64 w-full object-cover md:h-96"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            sizes="(max-width: 768px) 100vw, 768px"
          />
        </div>
      )
    }

    <!-- Información del artículo -->
    <div class="mb-8">

      {
        (date || author) && (
          <div class="mb-4 flex flex-wrap items-center text-sm text-gray-600">

            {
              date && (
                <span class="mr-4 flex items-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="mr-1 h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2v12a2 2 0 002 2z"
                    />
                  </svg>

                  <time datetime={date.toISOString()}>
                    {date.toLocaleDateString("es-MX", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </span>
              )
            }

            {
              author && (
                <span>
                  Por {author}
                </span>
              )
            }

          </div>
        )
      }

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">

            {tags.map((tag) => (
              <span
                class="rounded-full bg-primary-100 px-3 py-1 text-xs font-medium text-primary-700"
              >
                {tag}
              </span>
            ))}

          </div>
        )
      }

    </div>

    <!-- Contenido -->
    <article
      class="
        prose
        prose-lg
        max-w-none
        prose-headings:text-gray-900
        prose-h1:text-3xl
        prose-h2:text-2xl
        prose-h3:text-xl
        prose-h4:text-lg
        prose-p:text-gray-700
        prose-li:text-gray-700
        prose-strong:text-gray-900
        prose-a:text-primary-600
        hover:prose-a:text-primary-700
      "
    >
      <slot />
    </article>

  </div>
</div>

{type === "blog" && (
  <script>
    const progressBar = document.getElementById("reading-progress");
    let animationFrame = 0;

    const updateProgress = () => {
      if (!progressBar) return;

      const scrollableHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollableHeight > 0
        ? (window.scrollY / scrollableHeight) * 100
        : 0;

      progressBar.style.width = `${Math.min(progress, 100)}%`;
      animationFrame = 0;
    };

    const requestProgressUpdate = () => {
      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(updateProgress);
      }
    };

    window.addEventListener("scroll", requestProgressUpdate, { passive: true });
    window.addEventListener("resize", requestProgressUpdate);
    updateProgress();
  </script>
)}